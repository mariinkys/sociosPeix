# Local development settings for `cargo run` (copy to .env).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sociosPeix
DB_USERNAME=youruser
DB_PASSWORD=yourpassword
# ...or instead: DATABASE_URL=postgres://user:pass@localhost:5432/sociosPeix

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-this-please-32chars
CORS_ALLOWED_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

EMAIL_FROM=onboarding@resend.dev
RESEND_API_KEY=
MAILTRAP_API_KEY=

RUST_LOG=info,sociospeix=debug,sqlx=warn
