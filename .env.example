# Images
GITHUB_REPOSITORY=yourusername/sociospeix
IMAGE_TAG=latest # "latest" or a release tag, e.g. v0.3.0
HTTP_PORT=8080 # Host port the app is served on

# Database
DB_NAME=sociosPeix
DB_USERNAME=youruser
DB_PASSWORD=a-strong-password

# Security
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more # At least 32 characters
CORS_ALLOWED_ORIGIN=http://localhost:8080 # Public URL of the app (only matters if the API is called cross-origin).
COOKIE_SECURE=false # Set to true when the app is served over HTTPS.

# Email (A provider is enabled when its API key is set.)
EMAIL_FROM="Hotel Casa Peix <noreply@example.com>"
RESEND_API_KEY=
MAILTRAP_API_KEY=

# Optional (defaults shown)
# Time zone for "today": birthdays, daily email quotas, scheduled jobs.
# APP_TIMEZONE=Europe/Madrid
